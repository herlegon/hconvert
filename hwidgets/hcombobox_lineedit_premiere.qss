/* top, right, bottom, left */

QComboBox QLineEdit {
    /* background: transparent; */
    border: none;
    padding: 0px $padding 0px 0px;
    margin: 0px 0px 0px $padding;
}
QComboBox QLineEdit:read-only {
    /* background: transparent; */
    border: none;
    padding: 0px $padding 0px 0px;
    margin: 0px 0px 0px $padding;
}

