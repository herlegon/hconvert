QComboBox {
    color: #d4d4d8;
    font-family: "Segoe UI", "Sans Serif";
    font-size: 10pt;

    padding-left: $padding;
    /* border: 1px solid yellow; */
    border-radius: $radius;
    background-color: $bgd;
}

/* QComboBox:hover {
    border: 1px solid green;
} */

QComboBox::down-arrow {
    width: 0px;
    height: 0px;
}
QComboBox::drop-down {
    width: 0px;
    border: none;
}


